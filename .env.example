# Document Authenticity API Environment Configuration Template
# Copy this file to .env for local development

# Secret key required in 'X-API-Key' HTTP header
API_KEY=midv2020-secret-api-key-2026

# Maximum allowed file upload size in Megabytes (MB)
MAX_UPLOAD_SIZE_MB=10.0

# Comma-separated CORS allowed origins (e.g., http://localhost:3000,https://app.example.com)
ALLOWED_ORIGINS=*

# Application server port
PORT=8000

# Optional Parivahan / Third-Party Driving Licence Real-Time Verification API Configuration
# (Leave empty or unconfigured until you receive your API credentials from Parivahan/Surepass/Cashfree/Setu)
PARIVAHAN_API_URL=https://api.example.com/v1/dl/verify
PARIVAHAN_API_KEY=your_parivahan_api_key_here
PARIVAHAN_CLIENT_ID=your_parivahan_client_id_here
